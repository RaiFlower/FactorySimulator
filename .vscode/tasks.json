{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: FactorySimulator.DesktopGL",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/FactorySimulator.DesktopGL/FactorySimulator.DesktopGL.csproj",
